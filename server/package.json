{
  "name": "premiere-remote-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/server.ts",
    "start": "node dist/server.js",
    "generate:controllers": "ts-node --project tsconfig.scripts.json scripts/generateControllers.ts",
    "generate:api": "npm run generate:controllers && tsoa spec-and-routes",
    "generate:dispatchers": "ts-node --project tsconfig.scripts.json scripts/generateDispatchers.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.18.2",
    "tsoa": "^6.4.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.39",
    "@types/ws": "^8.5.10",
    "ts-morph": "^21.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
